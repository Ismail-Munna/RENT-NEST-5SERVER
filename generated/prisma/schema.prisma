model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]

  @@map("categories")
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum PropertyStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

model Payment {
  id              String    @id @default(uuid())
  rentalRequestId String
  userId          String
  amount          Float
  method          String
  provider        String
  status          String    @default("PENDING")
  transactionId   String?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rentalRequestId])
  @@index([userId])
  @@map("payments")
}

model Property {
  id         String  @id @default(uuid())
  landlordId String
  categoryId String?
  title      String

  description String?
  location    String
  city        String
  price       Float
  bedrooms    Int?

  bathrooms Int?
  areaSqft  Float?
  amenities String[]       @default([])
  images    String[]       @default([])
  status    PropertyStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landlord       User            @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  rentalRequests RentalRequest[]
  reviews        Review[]

  @@index([landlordId])
  @@index([categoryId])
  @@map("properties")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
}

model RentalRequest {
  id         String        @id @default(uuid())
  propertyId String
  tenantId   String
  status     RequestStatus @default(PENDING)
  message    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([propertyId])
  @@index([tenantId])
  @@map("rental_requests")
}

model Review {
  id         String  @id @default(uuid())
  propertyId String
  userId     String
  rating     Int
  comment    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@map("reviews")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  name  String @db.VarChar(255)
  email String @unique

  phone     String?
  password  String
  role      Role       @default(TENANT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  updatedAt DateTime @updatedAt

  properties     Property[]      @relation("LandlordProperties")
  rentalRequests RentalRequest[]
  payments       Payment[]
  reviews        Review[]

  @@map("users")
}
